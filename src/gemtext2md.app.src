{application, gemtext2md,
 [{description, "Gemini text to Markdown converter"},
  {vsn, "0.1.3"},
  {registered, []},
  {applications,
   [kernel,
    stdlib,
    gemini_text
   ]},
  {env, []},
  {modules, [
             gemtext2md,
             gemtext2md_cli
            ]},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub",
           "https://github.com/mk270/erl_gemtext2md"}]}
 ]}.
