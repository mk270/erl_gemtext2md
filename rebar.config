{erl_opts, [debug_info]}.
{deps, [{gemini_text, "~> 3.0"}]}.

%% -moduledoc and -doc (and so ex_doc) need OTP 27; gemini_text does too
{minimum_otp_vsn, "27"}.

{escript_main_app, gemtext2md}.
{escript_name, gemtext2md}.
{escript_emu_args,
 "%%! -escript main gemtext2md_cli -pz gemtext2md/gemtext2md/ebin\n"}.

{dialyzer, [
    {base_plt_apps, []},
    {plt_extra_apps, [erts]}
]}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, [{"README.md", #{title => "Overview"}},
              "CHECKSUMS.md"]},
    {main, "README.md"},
    {source_url, "https://github.com/mk270/erl_gemtext2md"}
]}.
